# ==========================================
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.lst
*.sym

# ==========================================
# 2. 仿真日志与运行时输出 (Simulation & Logs)
# ==========================================
qemu_output.log
*.log
*.dump
trace/

# ==========================================
# 3. Python & AI 辅助脚本缓存 (Python/RAG)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
vector_db/
chroma/
.cache/

# ==========================================
# 4. 开发工具与 IDE 配置 (IDEs & Editors)
# ==========================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains / CLion
.idea/
*.iml
*.ipr
*.iws
cmake-build-*/

# ==========================================
